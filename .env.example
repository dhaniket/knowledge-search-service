MONGODB_URI=mongodb+srv://username:password@hostname/
MONGODB_DATABASE=username

ELASTICSEARCH_URL=https://url
ELASTIC_API_KEY=api_key
ELASTICSEARCH_INDEX=index_name

REDIS_URL=redis://username:password@url
SEARCH_CACHE_TTL_SECONDS=

REDIS_OPERATION_TIMEOUT_SECONDS=1.0
ELASTICSEARCH_OPERATION_TIMEOUT_SECONDS=5.0
REINDEX_CONCURRENCY=10

RABBITMQ_URL=amqps://username:password@hostname/vhost
ARTICLE_INDEX_QUEUE=

KAFKA_BOOTSTRAP_SERVERS=your-aiven-sasl-host:port
KAFKA_USERNAME=your-aiven-username
KAFKA_PASSWORD=your-aiven-password
KAFKA_CA_FILE=certs/ca.pem

KAFKA_ARTICLE_TOPIC=
KAFKA_PUBLISH_TIMEOUT_SECONDS=5